---
import type { Brand } from '../data/brands';

interface Props {
  brands: Brand[];
}
const { brands } = Astro.props;
---

<nav class="index" aria-label="Cosmos brands">
  <ol>
    {
      brands.map((b) => (
        <li>
          <a href={`#${b.slug}`} data-index-link={b.slug}>
            <span class="index__label">{b.name}</span>
            <span class="index__tick" aria-hidden="true" />
          </a>
        </li>
      ))
    }
  </ol>
</nav>

<style>
  .index {
    position: fixed;
    top: 50%;
    right: max(clamp(1.25rem, 2.4vw, 2.25rem), env(safe-area-inset-right));
    z-index: 5;
    transform: translateY(-50%);
  }

  ol {
    display: grid;
    gap: 0.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  a {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 0.75rem;
    min-height: 2.25rem;
    padding-left: 1rem;
    text-decoration: none;
    color: var(--ink-soft);
  }

  .index__label {
    font-size: 0.8125rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    opacity: 0;
    transform: translateX(6px);
    transition:
      opacity 240ms var(--ease-out),
      transform 240ms var(--ease-out);
    text-shadow: var(--scrim-label);
  }

  /* Drawn at its current length and scaled down at rest, so it grows without relayout. */
  .index__tick {
    width: 28px;
    height: 1px;
    background: var(--ink-faint);
    transform: scaleX(0.5);
    transform-origin: right;
    transition:
      transform 320ms var(--ease-out),
      background-color 240ms var(--ease-out);
  }

  a:hover .index__label,
  a:focus-visible .index__label,
  a[aria-current] .index__label {
    opacity: 1;
    transform: none;
  }

  a:hover .index__tick,
  a:focus-visible .index__tick {
    background: var(--ink);
  }

  a[aria-current] {
    color: var(--ink);
  }

  a[aria-current] .index__tick {
    transform: none;
    background: var(--gold);
  }

  /* Phones and short landscape screens: a compact strip of ticks only. */
  @media (max-width: 759px), (max-height: 520px) {
    .index {
      right: max(0.25rem, env(safe-area-inset-right));
    }

    ol {
      gap: 0;
    }

    a {
      min-height: 1.75rem;
      padding-left: 0.75rem;
    }

    .index__label {
      display: none;
    }

    .index__tick {
      width: 18px;
      transform: scaleX(calc(10 / 18));
    }

    a[aria-current] .index__tick {
      transform: none;
    }
  }

  /* Touch: the tick stays small, the tap area does not. */
  @media (pointer: coarse) {
    a {
      min-width: 2.75rem;
      min-height: 2.75rem;
    }
  }

  /* Six 44px rows do not fit a phone on its side; 32px keeps them tappable. */
  @media (pointer: coarse) and (max-height: 520px) {
    a {
      min-height: 2rem;
    }
  }
</style>
