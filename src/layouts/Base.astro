---
import '@fontsource-variable/unbounded';
import '@fontsource-variable/geologica';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  /**
   * live: the page runs the WebGL sky; the still plate loads only if that fails.
   * plate: the page shows the still plate (and CSS grain) from the start.
   */
  sky?: 'live' | 'plate';
  /** Keep utility pages (such as the /warp/ redirect) out of search results. */
  noindex?: boolean;
}

const { title, description, sky = 'plate', noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const shareAlt = 'A spiral galaxy with a warm gold core and teal arms on a dark field of stars.';
---

<!doctype html>
<html lang="en" data-sky={sky}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#04060b" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="cosmos.maison" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {/* The share card: the plate cut to 1.91:1 as a JPEG, which every platform shows uncropped. */}
    <meta property="og:image" content={new URL('/og.jpg', Astro.site)} />
    <meta property="og:image:type" content="image/jpeg" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={shareAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image:alt" content={shareAlt} />
    {sky === 'plate' && <link rel="preload" href="/plate.webp" as="image" fetchpriority="high" />}
    {/* Mark scripting before first paint, so a visit without it gets the still plate (global.css). */}
    <script is:inline>document.documentElement.classList.add('js');</script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="sky-fallback" aria-hidden="true"></div>
    <slot name="sky" />
    <div class="grain" aria-hidden="true"></div>
    <div class="registration" aria-hidden="true"><span></span><span></span><span></span><span></span></div>
    <div class="page">
      <slot />
    </div>
    <slot name="overlay" />
  </body>
</html>
