---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
---

<Base title="Lost in space · cosmos.maison" description="This page drifted out of the Cosmos.">
  <main id="main" class="lost">
    <h1>This page drifted out of&nbsp;range</h1>
    <p>The address you followed doesn't point to anything in our Cosmos.</p>
    <div class="lost__actions">
      <a class="btn btn--warp" href="/warp/">
        <span>Warp to a random Cosmos</span>
        <Icon name="warp" />
      </a>
      <a class="btn btn--explore" href="/">
        <span>Back to cosmos.maison</span>
        <Icon name="up" />
      </a>
    </div>
  </main>
</Base>

<style>
  .lost {
    min-height: 100svh;
    display: grid;
    align-content: end;
    gap: 1.25rem;
    padding: 6rem var(--gutter) clamp(3.5rem, 9vh, 7rem);
    max-width: 48rem;
  }

  h1 {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 300;
    font-size: clamp(2.2rem, 1rem + 4.4vw, 4.5rem);
    line-height: 1.04;
    letter-spacing: -0.03em;
    text-wrap: balance;
  }

  p {
    margin: 0 0 1.25rem;
    color: var(--ink-soft);
    max-width: 40ch;
  }

  .lost__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.875rem;
  }
</style>
