---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
---

<Base title="Lost in space · cosmos.maison" description="This page drifted out of the Cosmos.">
  <main id="main" class="lost">
    <h1 class="headline">This page drifted out of&nbsp;range</h1>
    <p>The address you followed doesn't point to anything in our Cosmos.</p>
    <div class="lost__actions">
      <a class="btn btn--warp" href="/warp/">
        <span>Warp to a random Cosmos</span>
        <Icon name="warp" />
      </a>
      <a class="btn btn--explore" href="/">
        <span>Back to cosmos.maison</span>
        <Icon name="up" />
      </a>
    </div>
  </main>
</Base>

<style>
  .lost {
    min-height: 100vh;
    min-height: 100svh;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    align-content: end;
    gap: 1.25rem;
    padding: 6rem var(--gutter-right) clamp(3.5rem, 9vh, 7rem) var(--gutter-left);
    max-width: 48rem;
  }


  p {
    margin: 0 0 1.25rem;
    color: var(--ink-soft);
    max-width: 40ch;
    text-shadow: var(--scrim-text);
  }

  .lost__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.875rem;
  }

  @media (max-width: 759px) {
    .lost__actions {
      flex-direction: column;
      align-items: stretch;
      max-width: 22rem;
    }
  }
</style>
